# Copy this file to .env.local and fill in real values for local development.
# .env.local is git-ignored — never commit real secrets.
#
# These variables are read by docker-compose.yml (infra containers) and by
# each service's own config (see /pkg/config) when running locally outside
# of Docker.

# --- PostgreSQL ---
# Two connection identities (2026-09-14 fix -- see ARCHITECTURE_FLOW.md §5
# and GAPS.md's "Closed gaps" section for the full writeup):
#   - POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DSN: the Postgres SUPERUSER
#     docker-compose's postgres:16 image bootstraps. Every service's
#     Migrate() (env:"POSTGRES_DSN,required") uses this ONLY at startup to
#     run schema migrations and provision/grant the runtime role below --
#     never for ongoing queries.
#   - POSTGRES_RUNTIME_USER/POSTGRES_RUNTIME_PASSWORD/RUNTIME_POSTGRES_DSN:
#     the shared, non-superuser, NOBYPASSRLS role every service's REAL,
#     ongoing queries connect as (env:"RUNTIME_POSTGRES_DSN,required").
#     This is the fix for a real bug: Postgres superusers unconditionally
#     bypass Row-Level Security regardless of FORCE ROW LEVEL SECURITY, so
#     every RLS policy in this repo was silently a no-op against real
#     traffic when services connected as the superuser. The role itself
#     is provisioned idempotently by each service's own Migrate() (see
#     e.g. services/tenant-identity/internal/pgstore/runtime_role.go) --
#     nothing here creates it directly; POSTGRES_RUNTIME_PASSWORD here
#     must match what that provisioning call used (both default to
#     "ccaas_app_dev_password" if left unset -- see runtime_role.go's
#     defaultRuntimeRolePassword).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ccaas
POSTGRES_PASSWORD=ccaas_dev_password
POSTGRES_RUNTIME_USER=ccaas_app
POSTGRES_RUNTIME_PASSWORD=ccaas_app_dev_password
POSTGRES_DB=ccaas
# Full DSN convenience form some services may read directly:
POSTGRES_DSN=postgres://ccaas:ccaas_dev_password@localhost:5432/ccaas?sslmode=disable
RUNTIME_POSTGRES_DSN=postgres://ccaas_app:ccaas_app_dev_password@localhost:5432/ccaas?sslmode=disable

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- NATS (JetStream enabled) ---
NATS_HOST=localhost
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222

# --- Per-service gRPC ports (local dev defaults, one per service) ---
TENANT_IDENTITY_GRPC_PORT=50051
VOICE_MEDIA_GATEWAY_GRPC_PORT=50052
DIGITAL_CHANNELS_GATEWAY_GRPC_PORT=50053
TASK_ROUTER_GRPC_PORT=50054
AGENT_PRESENCE_GRPC_PORT=50055
WORKFLOW_IVR_GRPC_PORT=50056
HISTORICAL_REPORTING_GRPC_PORT=50057
BACKGROUND_WORKER_POOL_GRPC_PORT=50058
API_GATEWAY_GRPC_PORT=50059
