# Copy this file to .env.local and fill in real values for local development.
# .env.local is git-ignored — never commit real secrets.
#
# These variables are read by docker-compose.yml (infra containers) and by
# each service's own config (see /pkg/config) when running locally outside
# of Docker.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ccaas
POSTGRES_PASSWORD=ccaas_dev_password
POSTGRES_DB=ccaas
# Full DSN convenience form some services may read directly:
POSTGRES_DSN=postgres://ccaas:ccaas_dev_password@localhost:5432/ccaas?sslmode=disable

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=

# --- NATS (JetStream enabled) ---
NATS_HOST=localhost
NATS_PORT=4222
NATS_MONITOR_PORT=8222
NATS_URL=nats://localhost:4222

# --- Per-service gRPC ports (local dev defaults, one per service) ---
TENANT_IDENTITY_GRPC_PORT=50051
VOICE_MEDIA_GATEWAY_GRPC_PORT=50052
DIGITAL_CHANNELS_GATEWAY_GRPC_PORT=50053
TASK_ROUTER_GRPC_PORT=50054
AGENT_PRESENCE_GRPC_PORT=50055
WORKFLOW_IVR_GRPC_PORT=50056
HISTORICAL_REPORTING_GRPC_PORT=50057
BACKGROUND_WORKER_POOL_GRPC_PORT=50058
API_GATEWAY_GRPC_PORT=50059
