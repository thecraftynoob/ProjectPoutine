{
  "info": {
    "name": "ProjectPoutine",
    "_postman_id": "b8e1f3d0-2b7a-4c9e-9f1a-6c5d0a3e7f21",
    "description": "ProjectPoutine CCaaS platform API collection. Covers Tenant & Identity, Task Router (agent/task/reservation/admin), Digital Channels Gateway's inbound webhook, and API Gateway's ws-ticket endpoint.\n\nSee this repo's ARCHITECTURE_FLOW.md §1.1 for the full REST route table this collection mirrors, and GAPS.md for known auth/scope caveats (e.g. Digital Channels Gateway's webhook is intentionally unauthenticated this milestone).\n\n**Update this collection in the same change that adds/changes a REST route** — same discipline as ARCHITECTURE_FLOW.md (CLAUDE.md Rule 1) and GAPS.md (Rule 4). See postman/README.md for the full maintenance rule.\n\nRequires kubectl port-forward for api-gateway-svc and digital-channels-gateway-svc — see the collection-level variables and postman/README.md for exact commands.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "api_gateway_base",
      "value": "http://localhost:18080",
      "type": "string"
    },
    {
      "key": "dcg_base",
      "value": "http://localhost:18086",
      "type": "string"
    },
    {
      "key": "agent_presence_ws_base",
      "value": "ws://localhost:18085",
      "type": "string"
    },
    {
      "key": "tenant_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "jwt",
      "value": "",
      "type": "string"
    },
    {
      "key": "queue_id",
      "value": "support",
      "type": "string"
    },
    {
      "key": "agent_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "reservation_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "ws_ticket",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt}}",
        "type": "string"
      }
    ]
